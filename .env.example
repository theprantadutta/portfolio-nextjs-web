# ---------------------------------------------------------------------------
# Build-time values (inlined into the client bundle).
#
# Docker Compose reads these from `.env` in this directory and forwards them as
# build args. Changing any of them requires `docker compose build`, not just a
# restart. `NEXT_PUBLIC_STRAPI_PROD_API_URL` must be publicly reachable — it is
# what the browser uses for Strapi media URLs.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRAPI_DEV_API_URL=http://localhost:1337
NEXT_PUBLIC_STRAPI_PROD_API_URL=https://portfolio.pranta.dev

# ---------------------------------------------------------------------------
# Runtime secrets.
#
# Live in `.env.local`, which compose injects via `env_file`. Also needed at
# build time (STRAPI_API_KEY) because pages are prerendered from Strapi.
# ---------------------------------------------------------------------------
STRAPI_API_KEY=
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Server-only, runtime-only. Set by compose on the VPS, where the web and CMS
# containers share the external `proxy` network. Leave unset locally to fall
# back to the public URL.
# ---------------------------------------------------------------------------
# STRAPI_INTERNAL_URL=http://portfolio-strapi-cms:1337
